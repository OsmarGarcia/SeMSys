# Porta HTTP da API
PORT=3000
NODE_ENV=development

# Conexão Oracle (Winthor) — mesma base acessada hoje pelo SeMSys desktop (mdlConexaoOracle.vb)
ORACLE_USER=sampaio
ORACLE_PASSWORD=changeme
# host:porta/SID, ex.: 192.168.0.20:1521/WINT
ORACLE_CONNECT_STRING=192.168.0.20:1521/WINT
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
# Timeout (segundos) para liberar conexões ociosas do pool
ORACLE_POOL_TIMEOUT=60
# Timeout (ms) de cada statement executado — protege contra queries presas
ORACLE_QUERY_TIMEOUT_MS=30000

# Filiais padrão (equivalentes a My.Settings.CodFilialProducao / CodFilialEstoque no VB.NET)
DEFAULT_CODFILIAL_PRODUCAO=1
DEFAULT_CODFILIAL_ESTOQUE=1

# Autenticação (JWT) — o token deve ser emitido por quem autentica o usuário
# contra o cadastro de funcionários do Winthor (PCEMPR); esta API só valida a assinatura.
JWT_SECRET=changeme-use-um-segredo-forte-em-producao
JWT_EXPECTED_ISSUER=semsys-auth

# Habilita o endpoint de emissão de token de desenvolvimento (NUNCA use em produção)
ENABLE_DEV_TOKEN=true

# CORS — origens permitidas, separadas por vírgula. Use * apenas em desenvolvimento.
CORS_ALLOWED_ORIGINS=*

# Nível de log (pino): trace|debug|info|warn|error|silent
LOG_LEVEL=info
